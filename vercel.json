{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["model.pkl"] }
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "app.py",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
